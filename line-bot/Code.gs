/**
 * 自由なキャリア・転職相談に対してOpenAI API（gpt-4o-mini）で個別回答生成
 * （GitHubオウンドメディアのURLを必ず紐付けて返信）
 */

function generateAICareerAdvice(userQuestion) {
  const url = 'https://api.openai.com/v1/chat/completions';
  
  const systemPrompt = `あなたはハイクラス転職とAIキャリア自動化の第一人者「AI先生」です。
LINEで読者から寄せられたキャリア・転職の悩み相談に対して、温かく共感しつつ、極めて切れ味の鋭いプロフェッショナルな個別アドバイスを提供してください。

【あなたのミッションとURL紐付け方針】：
1. 相談者の悩み（年齢、現職、年収、不安、希望の働き方）を瞬時に言語化・肯定する。
2. 一般論ではなく、業界のリアルな年収構造や非公開求人の実態に基づいた具体的な戦略を提示する。
3. 相談内容に応じて、以下の公式オウンドメディア記事URLの中から最も適切なURLを必ず回答文末に1つ添えて案内してください。

【公式オウンドメディアURL一覧（※必ずこの正規URLを挿入すること）】：
- 転職エージェント比較・年収交渉・職務経歴書全般：
  https://qoo22.github.io/career-portal/guide.html
- 英語力アップ・外資系ケース面接・英語コーチング：
  https://qoo22.github.io/career-portal/english-coaching.html
- IT転職・未経験プログラミング・リスキリング補助金・フルリモート：
  https://qoo22.github.io/career-portal/it-reskilling.html
- 資産形成・新NISA・高配当株・サイドFIRE：
  https://qoo22.github.io/career-portal/securities-guide.html
- 総合ポータル：
  https://qoo22.github.io/career-portal/

【トーン＆ルール】：
- 誠実で知的、自信に満ちた頼れるプロのトーン。
- スマホのLINEで読みやすいよう、適度に改行と箇条書き、絵文字を使い、文字数は300〜450文字程度に収めてください。
- アフィリエイトURLや詳細記事として「▼詳細解説と無料面談はこちら👇：[正規URL]」の形式で必ず上記の実URLを1つ記載してください。ダミーURLや[※URL]は禁止です。`;

  const payload = {
    model: 'gpt-4o-mini',
    messages: [
      { role: 'system', content: systemPrompt },
      { role: 'user', content: userQuestion }
    ],
    temperature: 0.7,
    max_tokens: 700
  };
  
  const options = {
    method: 'post',
    contentType: 'application/json',
    headers: {
      Authorization: 'Bearer ' + OPENAI_API_KEY
    },
    payload: JSON.stringify(payload),
    muteHttpExceptions: true
  };
  
  try {
    const response = UrlFetchApp.fetch(url, options);
    const json = JSON.parse(response.getContentText());
    if (json.choices && json.choices.length > 0) {
      return json.choices[0].message.content.trim();
    } else {
      return 'ご相談ありがとうございます！現在アクセスが集中しております。まずは以下のハイクラス転職マスターガイドから、各領域の特化エージェントの非公開枠をご確認ください！\n\n▼詳細はこちら👇\n' + URLS.GUIDE;
    }
  } catch (err) {
    console.error('OpenAI API Error:', err);
    return 'ご相談ありがとうございます！現在アクセスが集中しております。まずは以下のハイクラス転職マスターガイドから、各領域の特化エージェントの非公開枠をご確認ください！\n\n▼詳細はこちら👇\n' + URLS.GUIDE;
  }
}


function sendLineReply(replyToken, messages, quickReplyItems) {
  const url = 'https://api.line.me/v2/bot/message/reply';
  
  let msgArray = [];
  if (typeof messages === 'string') {
    // スマホ画面で文字が多すぎる場合は読みやすく2分割（1,300文字超かつ区切りがある場合）
    if (messages.length > 1300 && messages.includes('━━━━━━━━━━━━\n🛠【再現性')) {
      const parts = messages.split('━━━━━━━━━━━━\n🛠【再現性');
      msgArray.push({ type: 'text', text: parts[0].trim() });
      msgArray.push({ type: 'text', text: '🛠【再現性' + parts[1].trim() });
    } else {
      msgArray.push({ type: 'text', text: messages });
    }
  } else if (Array.isArray(messages)) {
    msgArray = messages;
  } else if (typeof messages === 'object' && messages !== null) {
    msgArray = [messages];
  }
  
  if (msgArray.length === 0) return;
  if (msgArray.length > 5) msgArray = msgArray.slice(0, 5);
  
  // 最後のメッセージにQuickReplyボタンを付与
  if (quickReplyItems && quickReplyItems.length > 0) {
    const lastIdx = msgArray.length - 1;
    if (msgArray[lastIdx].type === 'text') {
      msgArray[lastIdx].quickReply = makeQuickReply(quickReplyItems);
    }
  }
  
  const payload = {
    replyToken: replyToken,
    messages: msgArray
  };
  
  const options = {
    method: 'post',
    contentType: 'application/json',
    headers: {
      Authorization: 'Bearer ' + LINE_CHANNEL_ACCESS_TOKEN
    },
    payload: JSON.stringify(payload),
    muteHttpExceptions: true
  };
  
  UrlFetchApp.fetch(url, options);
}
